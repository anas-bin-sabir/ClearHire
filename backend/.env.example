# App
APP_NAME=ClearHire API
DEBUG=false
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?

# PostgreSQL (async URL for SQLAlchemy); docker-compose exposes 5435 on the host
DATABASE_URL=postgresql+asyncpg://clearhire:clearhire123@localhost:5435/clearhire_db
# Apply Alembic migrations on startup (set false if a release step runs them)
AUTO_MIGRATE=true
# Allow admins to (re)seed demo data via POST /seed; disable in production
SEED_ENABLED=true

# Anthropic Claude (requirement extraction + explanations; optional, deterministic
# fallbacks are used when the key is empty or a call fails)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Embeddings: "local" = all-MiniLM-L6-v2 via fastembed/ONNX (384-d, ~90 MB download
# on first use); "hash" = deterministic stand-in for tests/CI (not semantic)
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
# Persistent model cache (default is a temp dir, re-downloaded after reboots)
EMBEDDING_CACHE_DIR=.cache/fastembed

# Rate limiting (in-memory per process)
RATE_LIMIT_ENABLED=true

# Moderate limits for public/read-heavy endpoints (search and list views)
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# Looser limits for authenticated-user actions (create/update freelancers, projects,
# contracts, team builds, settings, ...)
RATE_LIMIT_USER_MAX_REQUESTS=300
RATE_LIMIT_USER_WINDOW_SECONDS=60

# Strict limits for /auth/login and /auth/signup: combined per-IP and per-account
# exponential backoff instead of a hard lockout.
RATE_LIMIT_AUTH_FREE_ATTEMPTS=3
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=1.0
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=300.0
