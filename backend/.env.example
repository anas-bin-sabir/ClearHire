# App
APP_NAME=ClearHire API
DEBUG=false
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?

# PostgreSQL (async URL for SQLAlchemy); docker-compose exposes 5435 on the host
DATABASE_URL=postgresql+asyncpg://clearhire:clearhire123@localhost:5435/clearhire_db
# Hosted (Supabase, see docs/SUPABASE.md): use the *session pooler* string from
# Project Settings -> Database -> Connect, with the +asyncpg driver. URL-encode special
# characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, % -> %25).
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS: empty = auto (require for *.supabase.co / *.supabase.com hosts, disabled otherwise);
# or one of require | verify-full | disable
DB_SSL_MODE=
# Connection pool per API process. Keep it small on Supabase free tier (limited
# pooler connections); pool_size + max_overflow is the per-process ceiling.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# asyncpg prepared-statement cache. Leave unset: it is set to 0 automatically on port
# 6543 (Supabase transaction pooler, which can't hold prepared statements).
# DB_STATEMENT_CACHE_SIZE=0
# Apply Alembic migrations on startup (set false if a release step runs them)
AUTO_MIGRATE=true
# Allow admins to (re)seed demo data via POST /seed; disable in production
SEED_ENABLED=true

# Anthropic Claude (requirement extraction + explanations; optional, deterministic
# fallbacks are used when the key is empty or a call fails)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Neo4j graph read model (optional; derived from Postgres, never authoritative).
# Empty NEO4J_URI = disabled: graph features fall back to recursive CTEs in Postgres.
# Local: docker compose up neo4j, then bolt://localhost:7687. AuraDB Free: neo4j+s://<id>.databases.neo4j.io
# After enabling, run POST /admin/graph/rebuild once (or re-seed) to fill the graph.
NEO4J_URI=
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=clearhire123
# NEO4J_DATABASE=neo4j
# GraphRAG skill expansion over RELATED_TO (hops 1-3, weight decay per extra hop)
# GRAPH_EXPANSION_HOPS=2
# GRAPH_EXPANSION_DECAY=0.5
# How often the background task drains the graph_outbox table into Neo4j
# GRAPH_SYNC_INTERVAL_SECONDS=2

# Embeddings: "local" = all-MiniLM-L6-v2 via fastembed/ONNX (384-d, ~90 MB download
# on first use); "hash" = deterministic stand-in for tests/CI (not semantic)
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
# Persistent model cache (default is a temp dir, re-downloaded after reboots)
EMBEDDING_CACHE_DIR=.cache/fastembed

# LLM rerank of the top search candidates (deterministic reasoning without a key)
RERANK_ENABLED=true
RERANK_TOP_N=10
# final score = alpha * deterministic + (1 - alpha) * LLM fit
RERANK_ALPHA=0.6
RERANK_EFFORT=low

# Rate limiting (in-memory per process)
RATE_LIMIT_ENABLED=true

# Moderate limits for public/read-heavy endpoints (search and list views)
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# Looser limits for authenticated-user actions (create/update freelancers, projects,
# contracts, team builds, settings, ...)
RATE_LIMIT_USER_MAX_REQUESTS=300
RATE_LIMIT_USER_WINDOW_SECONDS=60

# Strict limits for /auth/login and /auth/signup: combined per-IP and per-account
# exponential backoff instead of a hard lockout.
RATE_LIMIT_AUTH_FREE_ATTEMPTS=3
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=1.0
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=300.0
