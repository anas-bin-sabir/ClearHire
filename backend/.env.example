# ClearHire API configuration.
# Copy to backend/.env for local development. On Render, set the same names in the
# service's Environment tab (render.yaml already sets the non-secret ones).
# Every variable is listed; anything marked "default" can be left out.
# Full deployment guide: docs/SUPABASE.md

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ClearHire API
DEBUG=false
# Signs local-mode JWTs. Required in production even with Supabase Auth.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Lifetime of local-mode JWTs in minutes (default 1440 = 24h). Unused with Supabase Auth,
# whose tokens last an hour and are renewed through POST /auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# Production: CORS_ORIGINS=https://clearhire-talent.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra origins by regex. Leave empty in production.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?

# ── Authentication (Supabase Auth) ───────────────────────────────────────────
# auto = Supabase Auth when SUPABASE_URL is set, else local (the app's own password
# hashes and JWTs; used by tests and offline dev). Production: supabase.
AUTH_PROVIDER=auto
# Project URL: Supabase dashboard -> Project Settings -> Data API
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API Keys. All three are server-only: never put them in the frontend.
# Publishable key (sb_publishable_...) or legacy anon key: sign-in and token refresh.
SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key: creates users. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Only if Project Settings -> JWT Keys says the project still uses the legacy JWT
# secret. Projects on signing keys (the default) are verified via JWKS: leave empty.
SUPABASE_JWT_SECRET=
# Timeout for calls to Supabase Auth, in seconds (default 10)
SUPABASE_TIMEOUT_SECONDS=10

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Session pooler string from the dashboard's Connect button, with +asyncpg added.
# Port 5432 (session pooler), not 6543 and not the IPv6-only db.<ref>.supabase.co host.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F,
# # -> %23, ? -> %3F, % -> %25). Don't append ?sslmode=.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local Docker instead (docker compose up -d):
# DATABASE_URL=postgresql+asyncpg://clearhire:clearhire123@localhost:5435/clearhire_db

# TLS: empty = auto (require for *.supabase.co / *.supabase.com hosts, off otherwise),
# or one of disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=
# Connections per API process. Keep small on the Supabase free tier;
# pool size + overflow is the per-process ceiling.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# asyncpg prepared-statement cache. Leave unset: it becomes 0 automatically on
# port 6543 (transaction pooler, which can't hold prepared statements).
# DB_STATEMENT_CACHE_SIZE=0
# Open a new connection per checkout instead of pooling (tests only; default false)
DB_NULL_POOL=false
# Apply Alembic migrations on startup (set false if a release step runs them)
AUTO_MIGRATE=true
# Allow admins to (re)seed demo data via POST /seed. Set false in production.
SEED_ENABLED=true

# ── Language model (Gemini) ──────────────────────────────────────────────────
# Requirement extraction, search rerank and explanations. Optional: without a key
# (or when a call fails or hits the rate limit) deterministic fallbacks are used.
# auto = Gemini if GEMINI_API_KEY is set, else Anthropic. Or force gemini | anthropic.
LLM_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Fastest current model
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# Extra output-token budget for the model's internal thinking (default 8192)
GEMINI_THINKING_HEADROOM=8192

# Anthropic Claude: only used with LLM_PROVIDER=anthropic (or auto without a Gemini key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=60

# ── Embeddings ───────────────────────────────────────────────────────────────
# local = all-MiniLM-L6-v2 via fastembed/ONNX, runs inside the API (~90 MB download
# on first use); hash = deterministic stand-in for tests/CI (not semantic)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the vector(384) columns in the database
EMBEDDING_DIMENSIONS=384
# Persistent model cache (empty = temp dir, re-downloaded after reboots)
EMBEDDING_CACHE_DIR=.cache/fastembed
# Minimum similarity for mapping an extracted skill to a canonical one
SKILL_GROUNDING_MIN_SIMILARITY=0.72

# ── Search and ranking ───────────────────────────────────────────────────────
# LLM rerank of the top candidates (deterministic reasoning without a key)
RERANK_ENABLED=true
RERANK_TOP_N=10
# final score = alpha * deterministic + (1 - alpha) * LLM fit
RERANK_ALPHA=0.6
# low | medium | high
RERANK_EFFORT=low
# Weight of the full-text channel relative to vectors in rank fusion
SEARCH_KEYWORD_RRF_WEIGHT=0.5
# Ranking feature weights, tuned in docs/EVAL.md
RANK_WEIGHT_SEMANTIC=0.48
RANK_WEIGHT_KEYWORD=0.12
RANK_WEIGHT_SKILL=0.12
RANK_WEIGHT_EXPERIENCE=0.08
RANK_WEIGHT_RATING=0.04
RANK_WEIGHT_BUDGET=0.08
RANK_WEIGHT_AVAILABILITY=0.04
RANK_WEIGHT_FRAUD=0.04

# ── Graph ────────────────────────────────────────────────────────────────────
# Empty = graph features run on Postgres (recursive CTEs), which is the Supabase
# setup. Set only to use an optional Neo4j read model.
NEO4J_URI=
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
# Skill expansion over related skills: hops (1-3) and weight decay per extra hop
GRAPH_EXPANSION_HOPS=2
GRAPH_EXPANSION_DECAY=0.5
# Neo4j outbox drain interval in seconds (unused without Neo4j)
GRAPH_SYNC_INTERVAL_SECONDS=2

# ── Rate limiting (in-memory, per process) ───────────────────────────────────
RATE_LIMIT_ENABLED=true
# Public and read-heavy endpoints (search, lists)
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
# Signed-in user actions (create/update, team builds, settings, token refresh)
RATE_LIMIT_USER_MAX_REQUESTS=300
RATE_LIMIT_USER_WINDOW_SECONDS=60
# /auth/login and /auth/signup: per-IP and per-account exponential backoff
RATE_LIMIT_AUTH_FREE_ATTEMPTS=3
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=1.0
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=300.0
