# App
APP_NAME=ClearHire API
DEBUG=true
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?

# PostgreSQL (async URL for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://clearhire:clearhire123@localhost:5432/clearhire_db

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=clearhire

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clearhire123

# Anthropic Claude (explanation engine)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# pgvector embedding size (must match model)
EMBEDDING_DIMENSIONS=384

# Rate limiting (in-memory per process; back with Redis if scaling to multiple workers)
RATE_LIMIT_ENABLED=true

# Moderate limits for public/read-heavy endpoints (search, graph, stats, list views, ...)
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# Looser limits for authenticated-user actions (create/update freelancers, projects,
# contracts, team builds, settings, ...)
RATE_LIMIT_USER_MAX_REQUESTS=300
RATE_LIMIT_USER_WINDOW_SECONDS=60

# Strict limits for /auth/login and /auth/signup: combined per-IP and per-account
# exponential backoff instead of a hard lockout.
RATE_LIMIT_AUTH_FREE_ATTEMPTS=3
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=1.0
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=300.0
