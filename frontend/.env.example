# ClearHire frontend configuration.
# Copy to frontend/.env.local for local development. On Vercel, set the same names
# under Project -> Settings -> Environment Variables (Production and Preview), then
# redeploy: NEXT_PUBLIC_* values are compiled into the build.
# No Supabase keys belong here: the browser only talks to the FastAPI backend.

# FastAPI backend URL, no trailing slash.
# Production: https://<your-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# The site's own URL, used by NextAuth for callbacks and redirects.
# Production: https://clearhire-talent.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Encrypts the NextAuth session cookie (which holds the API tokens). Required in
# production. Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=
